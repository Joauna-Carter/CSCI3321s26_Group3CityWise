<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CityWise</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .home-actions {
            margin-top: 22px;
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .home-button {
            display: inline-block;
            padding: 11px 18px;
            border-radius: 8px;
            background-color: #2f7c95;
            color: white;
            font-weight: bold;
            text-decoration: none;
        }

        .home-button:hover {
            background-color: #25657a;
        }
    </style>
</head>
<body>

    <header class="navbar">
        <div class="nav-left">
            <a href="/" class="logo">CityWise</a>
        </div>

        <div class="nav-center">
            <a href="/" class="nav-tab">Home</a>
            <a href="/cities" class="nav-tab">City Trivia</a>
            <a href="/study" class="nav-tab">Study &amp; Quiz</a>
            <a href="/map" class="nav-tab">Map</a>
            <a href="/leaderboard" class="nav-tab">Leaderboard</a>
            <a href="/statistics" class="nav-tab">Statistics</a>

            <% if (isAdmin) { %>
                <a href="/admin" class="nav-tab">Admin</a>
            <% } %>
        </div>

        <div class="nav-right">
            <% if (!isLoggedIn) { %>
                <a href="/register">Create Account</a>
                <span class="divider">|</span>
                <a href="/login">Log In</a>
            <% } else { %>
                <a href="/profile"><%= username %></a>
                <span class="divider">|</span>
                <a href="/logout">Log Out</a>
            <% } %>
        </div>
    </header>

    <main class="home-container">
        <section class="hero">
            <h1>Welcome to CityWise</h1>

            <p>
                Explore cities around the world, learn interesting facts, study with flashcards,
                and test your knowledge with trivia quizzes.
            </p>

        </section>

        <section class="home-info">
            <h2 style="margin-top: 10vh;">What You Can Do</h2>

            <div class="city-grid">
                <a href="/cities" style="text-decoration: none;">
                <div class="city-card">
                    <h3>Browse Cities</h3>
                    <p>Open city trivia pages to learn descriptions, quick facts, locations, and fun trivia.</p>
                </div>
                </a>

                <a href="/study" style="text-decoration: none;">
                <div class="city-card">
                    <h3>Study &amp; Quiz</h3>
                    <p>Choose a city, region, or random mode to study with flashcards or take a quiz.</p>
                </div>
                </a>

                <a href="/map" style="text-decoration: none;">
                <div class="city-card">
                    <h3>Explore the Map</h3>
                    <p>Use the map page to explore city locations and jump directly to city trivia pages.</p>
                </div>
                </a>

                <a href="/leaderboard" style="text-decoration: none;">
                <div class="city-card">
                    <h3>Track Progress</h3>
                    <p>View leaderboard rankings and personal statistics as you complete quizzes.</p>
                </div>
                </a>
            </div>
        </section>
    </main>

</body>
</html>
